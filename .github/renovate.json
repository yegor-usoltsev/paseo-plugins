{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all",
    ":enablePreCommit",
    ":reviewer(yegor-usoltsev)"
  ],
  "schedule": ["on the 10th day of the month"],
  "packageRules": [
    {
      "description": "Plugin dependencies follow the paseo plugin init template.",
      "matchFileNames": ["package.json"],
      "matchPackageNames": [
        "@getpaseo/*",
        "@tanstack/react-query",
        "@types/node",
        "@types/react",
        "react",
        "react-native",
        "typescript",
        "zod"
      ],
      "enabled": false
    }
  ]
}
